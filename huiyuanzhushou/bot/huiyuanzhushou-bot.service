[Unit]
Description=Huiyuan Zhushou Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ycsc/huiyuanzhushou/bot
EnvironmentFile=/opt/ycsc/huiyuanzhushou/bot/.env
ExecStart=/opt/ycsc/huiyuanzhushou/bot/.venv/bin/python main.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
